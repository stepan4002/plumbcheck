{
  "name": "plumbcheck",
  "version": "1.0.1",
  "description": "Test what your AI automation does before it does it. Local tool-call contracts, fixture replay, and CI reports.",
  "type": "module",
  "license": "MIT",
  "author": "Plumbnote <hello@plumbnote.com>",
  "homepage": "https://github.com/stepan4002/plumbcheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepan4002/plumbcheck.git"
  },
  "bugs": {
    "url": "https://github.com/stepan4002/plumbcheck/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "plumbcheck": "bin/plumbcheck.js",
    "plumbcheck-mcp": "bin/plumbcheck-mcp.js",
    "plumbcheck-control": "bin/plumbcheck-control.js",
    "plumbcheck-sync": "bin/plumbcheck-sync.js",
    "plumcheck": "bin/plumcheck.js",
    "plumcheck-mcp": "bin/plumcheck-mcp.js"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "web",
    "examples",
    "schema",
    "adapters/python/plumbcheck.py",
    "adapters/python/README.md",
    "docs/CONTRACTS.md",
    "docs/CONNECT_YOUR_AGENT.md",
    "docs/MCP.md",
    "docs/TYPESCRIPT.md",
    "docs/AGENT_TESTING.md",
    "docs/ASSISTANT_INTEGRATION.md",
    "docs/WORKBENCH.md",
    "docs/WINDOWS_APP.md",
    "docs/APP_WORKSPACE.md",
    "docs/STABILITY.md",
    "docs/PRIVACY.md",
    "docs/TROUBLESHOOTING.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:mcp": "npm --prefix compat/mcp-sdk test",
    "test:types": "npm --prefix compat/typescript test",
    "test:local-model": "node scripts/check-local-model.mjs",
    "demo": "node bin/plumbcheck.js demo",
    "start": "node bin/plumbcheck.js studio",
    "desktop:dev": "npm --prefix desktop start",
    "desktop:build": "npm --prefix desktop run build:win",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:preview": "node scripts/preview-mobile.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "release:check": "node scripts/release-check.mjs",
    "version:set": "node scripts/set-version.mjs",
    "sbom": "node scripts/build-sbom.mjs",
    "check": "node bin/plumbcheck.js run examples/customer-support/safe.json",
    "example:sdk": "node examples/customer-support/agent.js",
    "check:agent": "node bin/plumbcheck.js run examples/customer-support/agent-contract.json --agent examples/customer-support/support-agent.js --out reports/agent",
    "demo:agent": "node bin/plumbcheck.js run examples/customer-support/agent-contract.json --agent examples/customer-support/regressed-agent.js --out reports/regressed-agent",
    "check:calendar": "node bin/plumbcheck.js run examples/calendar-booking/agent-contract.json --agent examples/calendar-booking/booking-agent.js --out reports/calendar-agent",
    "demo:calendar": "node bin/plumbcheck.js run examples/calendar-booking/agent-contract.json --agent examples/calendar-booking/regressed-agent.js --out reports/regressed-calendar-agent",
    "test:probe": "node scripts/probe-model.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "testing",
    "regression",
    "automation",
    "fixtures",
    "ci"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.125",
    "@ai-sdk/openai": "4.0.122",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.181",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1"
  }
}
